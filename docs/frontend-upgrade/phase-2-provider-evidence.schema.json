{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantgym.invalid/schemas/frontend-upgrade-phase2-provider-evidence.schema.json",
  "title": "QuantGym Phase 2 Preview provider evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "status",
    "capturedAt",
    "expiresAt",
    "environment",
    "branch",
    "applicationCommit",
    "governance",
    "capture",
    "candidateGate",
    "operatorPreflight",
    "credentialBoundary",
    "resources",
    "productionContinuity",
    "deployments",
    "deploymentControls",
    "databaseBackup",
    "databaseMigration",
    "acceptanceData",
    "liveChecks",
    "cleanup",
    "temporaryAccess",
    "postRevokeContinuity",
    "pullRequest",
    "cutoverSequence",
    "cutoverDurationMs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "phase": { "const": 2 },
    "status": { "const": "pass" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "environment": { "const": "preview" },
    "branch": { "const": "codex/frontend-v2-preview" },
    "applicationCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "governance": { "$ref": "#/$defs/governance" },
    "capture": { "$ref": "#/$defs/capture" },
    "candidateGate": { "$ref": "#/$defs/candidateGate" },
    "operatorPreflight": { "$ref": "#/$defs/operatorPreflight" },
    "credentialBoundary": { "$ref": "#/$defs/credentialBoundary" },
    "resources": { "$ref": "#/$defs/resources" },
    "productionContinuity": { "$ref": "#/$defs/productionContinuity" },
    "deployments": { "$ref": "#/$defs/deployments" },
    "deploymentControls": { "$ref": "#/$defs/deploymentControls" },
    "databaseBackup": { "$ref": "#/$defs/databaseBackup" },
    "databaseMigration": { "$ref": "#/$defs/databaseMigration" },
    "acceptanceData": { "$ref": "#/$defs/acceptanceData" },
    "liveChecks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "prefixItems": [
        { "$ref": "#/$defs/liveCheckApi" },
        { "$ref": "#/$defs/liveCheckMigration" },
        { "$ref": "#/$defs/liveCheckDailyLoop" },
        { "$ref": "#/$defs/liveCheckAccessibility" },
        { "$ref": "#/$defs/liveCheckStorage" },
        { "$ref": "#/$defs/liveCheckProductionDenial" },
        { "$ref": "#/$defs/liveCheckDeployedVisual" },
        { "$ref": "#/$defs/liveCheckDeployedBundle" }
      ],
      "items": false
    },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "temporaryAccess": { "$ref": "#/$defs/temporaryAccess" },
    "postRevokeContinuity": { "$ref": "#/$defs/postRevokeContinuity" },
    "pullRequest": { "$ref": "#/$defs/pullRequest" },
    "cutoverSequence": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "prefixItems": [
        { "$ref": "#/$defs/cutoverStepBackup" },
        { "$ref": "#/$defs/cutoverStepRestoreProof" },
        { "$ref": "#/$defs/cutoverStepRestoreTargetDestroy" },
        { "$ref": "#/$defs/cutoverStepMigration" },
        { "$ref": "#/$defs/cutoverStepApiDeploy" },
        { "$ref": "#/$defs/cutoverStepPagesDeploy" },
        { "$ref": "#/$defs/cutoverStepLiveChecks" },
        { "$ref": "#/$defs/cutoverStepCleanup" },
        { "$ref": "#/$defs/cutoverStepRevoke" },
        { "$ref": "#/$defs/cutoverStepPostRevokeContinuity" }
      ],
      "items": false
    },
    "cutoverDurationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 21600000
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "budgetOwner", "dataResetOwner", "destroyOwner", "reviewDate"],
      "properties": {
        "operator": { "const": "Gary" },
        "budgetOwner": { "const": "Gary" },
        "dataResetOwner": { "const": "Gary" },
        "destroyOwner": { "const": "Gary" },
        "reviewDate": { "const": "2026-07-29" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticated", "inputSource", "rawResponsesPersisted", "journalTrustBoundary"],
      "properties": {
        "authenticated": { "const": true },
        "inputSource": { "const": "operator-environment" },
        "rawResponsesPersisted": { "const": false },
        "journalTrustBoundary": { "$ref": "#/$defs/journalTrustBoundary" }
      }
    },
    "journalTrustBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustRoot", "operator", "journalMode", "externalSignaturePresent", "sameUserTamperingOutOfScope", "evidenceSha256"],
      "properties": {
        "trustRoot": { "const": "local-system-user" },
        "operator": { "const": "Gary" },
        "journalMode": { "const": "0600" },
        "externalSignaturePresent": { "const": false },
        "sameUserTamperingOutOfScope": { "const": true },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidateGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt", "repository", "pullRequestNumber", "branch", "applicationCommit", "evidenceHeadCommit", "localHeadCommit", "remoteHeadCommit", "applicationCommitMessageSha256", "evidenceCommitMessageSha256", "workflowSha256", "ciContractSha256", "workflowRunIdentitySha256", "applicationCloudflarePagesSkipDirectivePresent", "evidenceCloudflarePagesSkipDirectivePresent", "evidenceOutputCount", "evidenceSuccessorOnly", "evidenceHeadCiGreen", "applicationPagesSkipRecordCount", "evidencePagesSkipRecordCount", "pagesSkipObservationSha256", "trackedWorktreeClean", "indexClean", "allowedUntrackedOnly", "requiredAncestorCommits", "allRequiredAncestorsPresent", "pullRequestState", "pullRequestDraft", "pullRequestMerged", "pullRequestHeadCommit", "evidenceSha256"],
      "properties": {
        "status": { "const": "pass" },
        "checkedAt": { "$ref": "#/$defs/timestamp" },
        "repository": { "const": "garymmmjw/QuantGym" },
        "pullRequestNumber": { "const": 130 },
        "branch": { "const": "codex/frontend-v2-preview" },
        "applicationCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "evidenceHeadCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "localHeadCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "remoteHeadCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "applicationCommitMessageSha256": { "$ref": "#/$defs/sha256" },
        "evidenceCommitMessageSha256": { "$ref": "#/$defs/sha256" },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "ciContractSha256": { "$ref": "#/$defs/sha256" },
        "workflowRunIdentitySha256": { "$ref": "#/$defs/sha256" },
        "applicationCloudflarePagesSkipDirectivePresent": { "const": true },
        "evidenceCloudflarePagesSkipDirectivePresent": { "const": true },
        "evidenceOutputCount": { "const": 30 },
        "evidenceSuccessorOnly": { "const": true },
        "evidenceHeadCiGreen": { "const": true },
        "applicationPagesSkipRecordCount": { "type": "integer", "minimum": 1 },
        "evidencePagesSkipRecordCount": { "type": "integer", "minimum": 1 },
        "pagesSkipObservationSha256": { "$ref": "#/$defs/sha256" },
        "trackedWorktreeClean": { "const": true },
        "indexClean": { "const": true },
        "allowedUntrackedOnly": { "const": true },
        "requiredAncestorCommits": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "5a3b6f33b7f2a4d15f0a81ca57f81570ca89c6a3" },
            { "const": "d87b20f8630fdc39f46e1065c5ffee14bf3ca8dd" },
            { "const": "4faba0653e28e4ca28edd8521a053d00d0d88e57" },
            { "const": "4bed12b2b9951276124df2fff18b23f2319c8de1" }
          ],
          "items": false
        },
        "allRequiredAncestorsPresent": { "const": true },
        "pullRequestState": { "const": "open" },
        "pullRequestDraft": { "const": true },
        "pullRequestMerged": { "const": false },
        "pullRequestHeadCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "credentialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identitySha256", "selfIdentityVerified"],
      "properties": {
        "identitySha256": { "$ref": "#/$defs/sha256" },
        "selfIdentityVerified": { "const": true }
      }
    },
    "mutationTokenBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloudflare", "render", "postgres", "r2"],
      "properties": {
        "cloudflare": { "$ref": "#/$defs/credentialBinding" },
        "render": { "$ref": "#/$defs/credentialBinding" },
        "postgres": { "$ref": "#/$defs/credentialBinding" },
        "r2": { "$ref": "#/$defs/credentialBinding" }
      }
    },
    "operatorPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt", "candidateCommit", "capabilitiesReady", "toolchainReady", "controlDatabaseReadOnly", "previewR2RunPrefixEmpty", "mutationR2RunPrefixEmpty", "frontendBuildPassed", "localDowngradeGatePassed", "proxyLoopback", "proxyIdentitySha256", "remainingReadOnlyControlProofs", "terminalTemporaryControl", "mutationTokenBindings", "evidenceSha256"],
      "properties": {
        "status": { "const": "pass" },
        "checkedAt": { "$ref": "#/$defs/timestamp" },
        "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "capabilitiesReady": { "const": true },
        "toolchainReady": { "const": true },
        "controlDatabaseReadOnly": { "const": true },
        "previewR2RunPrefixEmpty": { "const": true },
        "mutationR2RunPrefixEmpty": { "const": true },
        "frontendBuildPassed": { "const": true },
        "localDowngradeGatePassed": { "const": true },
        "proxyLoopback": { "const": true },
        "proxyIdentitySha256": { "$ref": "#/$defs/sha256" },
        "remainingReadOnlyControlProofs": { "$ref": "#/$defs/remainingReadOnlyControlProofs" },
        "terminalTemporaryControl": { "$ref": "#/$defs/terminalTemporaryControl" },
        "mutationTokenBindings": { "$ref": "#/$defs/mutationTokenBindings" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "controlCredentialRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "remainingReadOnlyProviders", "terminalTemporaryUnscopedProviders", "terminalTemporaryProviders", "terminalRevocationRequired", "retainedAfterMutationRevoke", "identitySha256"],
      "properties": {
        "kind": { "const": "control" },
        "remainingReadOnlyProviders": {
          "const": ["cloudflare", "r2"]
        },
        "terminalTemporaryUnscopedProviders": {
          "const": ["render"]
        },
        "terminalTemporaryProviders": {
          "const": ["postgres", "render"]
        },
        "terminalRevocationRequired": { "const": true },
        "retainedAfterMutationRevoke": { "const": true },
        "identitySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bootstrapCredentialRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "privilege", "retained", "excludedFromReadOnlyControlAssertions", "identitySha256"],
      "properties": {
        "kind": { "const": "persistent-provider-admin" },
        "provider": { "const": "postgres" },
        "privilege": { "const": "admin" },
        "retained": { "const": true },
        "excludedFromReadOnlyControlAssertions": { "const": true },
        "identitySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "remainingReadOnlyControlProofs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloudflare", "r2"],
      "properties": {
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountBound", "providerScopeReadOnly", "evidenceSha256"],
          "properties": {
            "accountBound": { "const": true },
            "providerScopeReadOnly": { "const": true },
            "evidenceSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "r2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policyBucketBound", "policyReadOnly", "previewReadSucceeded", "previewWriteDenied", "productionAccessDenied", "evidenceSha256"],
          "properties": {
            "policyBucketBound": { "const": true },
            "policyReadOnly": { "const": true },
            "previewReadSucceeded": { "const": true },
            "previewWriteDenied": { "const": true },
            "productionAccessDenied": { "const": true },
            "evidenceSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "terminalTemporaryControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers", "unscopedProviders", "terminalRevocationRequired", "postgres", "renderCredentialIdentitySha256"],
      "properties": {
        "providers": { "const": ["postgres", "render"] },
        "unscopedProviders": { "const": ["render"] },
        "terminalRevocationRequired": { "const": true },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicationDmlDenied", "ddlDenied", "largeObjectCreationDenied", "selectSucceeded", "sqlManagedTemporaryRole", "transactionReadOnly", "finalDropRequired", "providerCredentialInventoryUnchanged", "providerCredentialInventorySha256", "persistentProviderAdmin", "evidenceSha256"],
          "properties": {
            "applicationDmlDenied": { "const": true },
            "ddlDenied": { "const": true },
            "largeObjectCreationDenied": { "const": true },
            "selectSucceeded": { "const": true },
            "sqlManagedTemporaryRole": { "const": true },
            "transactionReadOnly": { "const": true },
            "finalDropRequired": { "const": true },
            "providerCredentialInventoryUnchanged": { "const": true },
            "providerCredentialInventorySha256": { "$ref": "#/$defs/sha256" },
            "persistentProviderAdmin": { "$ref": "#/$defs/persistentProviderAdmin" },
            "evidenceSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "renderCredentialIdentitySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "persistentProviderAdmin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retained", "privilege", "excludedFromReadOnlyControlAssertions", "identitySha256", "sqlIdentitySha256", "providerCredentialInventoryUnchanged", "providerCredentialInventorySha256", "evidenceSha256"],
      "properties": {
        "retained": { "const": true },
        "privilege": { "const": "admin" },
        "excludedFromReadOnlyControlAssertions": { "const": true },
        "identitySha256": { "$ref": "#/$defs/sha256" },
        "sqlIdentitySha256": { "$ref": "#/$defs/sha256" },
        "providerCredentialInventoryUnchanged": { "const": true },
        "providerCredentialInventorySha256": { "$ref": "#/$defs/sha256" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "mutationCredentialRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revocable", "identitySha256"],
      "properties": {
        "kind": { "const": "mutation" },
        "revocable": { "const": true },
        "identitySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "credentialBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap", "control", "mutation", "identitiesDistinct"],
      "properties": {
        "bootstrap": { "$ref": "#/$defs/bootstrapCredentialRole" },
        "control": { "$ref": "#/$defs/controlCredentialRole" },
        "mutation": { "$ref": "#/$defs/mutationCredentialRole" },
        "identitiesDistinct": { "const": true }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "identitySha256"],
      "properties": {
        "provider": { "enum": ["cloudflare", "render"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "identitySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages", "api", "llm", "postgres", "r2", "productionPages", "productionApi", "productionLlm", "productionPostgres", "productionR2"],
      "properties": {
        "pages": { "$ref": "#/$defs/resource" },
        "api": { "$ref": "#/$defs/resource" },
        "llm": { "$ref": "#/$defs/resource" },
        "postgres": { "$ref": "#/$defs/resource" },
        "r2": { "$ref": "#/$defs/resource" },
        "productionPages": { "$ref": "#/$defs/resource" },
        "productionApi": { "$ref": "#/$defs/resource" },
        "productionLlm": { "$ref": "#/$defs/resource" },
        "productionPostgres": { "$ref": "#/$defs/resource" },
        "productionR2": { "$ref": "#/$defs/resource" }
      }
    },
    "productionServiceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identitySha256", "configurationSha256", "repository", "branch", "visibility", "automaticDeploysEnabled", "liveDeploymentCommit", "live"],
      "properties": {
        "name": { "enum": ["quantgym-api", "quantgym-llm"] },
        "identitySha256": { "$ref": "#/$defs/sha256" },
        "configurationSha256": { "$ref": "#/$defs/sha256" },
        "repository": { "const": "garymmmjw/QuantGym" },
        "branch": { "const": "main" },
        "visibility": { "enum": ["public", "internal"] },
        "automaticDeploysEnabled": { "type": "boolean" },
        "liveDeploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "live": { "const": true }
      }
    },
    "productionAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pagesDeploymentCommit", "pagesResourceIdentitySha256", "pagesConfigurationSha256", "pagesSuccessfulDeploymentSetSha256", "pagesEnvironment", "pagesBranch", "pagesAutomaticDeploysEnabled", "pagesLive", "candidateCommitChecked", "candidateCommitRecordCount", "candidateCommitSkippedRecordCount", "candidateCommitStartedRecordCount", "candidateCommitAliasedRecordCount", "candidateCommitActiveDeploymentCount", "services", "postgresControlSha256", "r2ControlSha256", "environmentGroupsControlSha256"],
      "properties": {
        "pagesDeploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pagesResourceIdentitySha256": { "$ref": "#/$defs/sha256" },
        "pagesConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "pagesSuccessfulDeploymentSetSha256": { "$ref": "#/$defs/sha256" },
        "pagesEnvironment": { "const": "production" },
        "pagesBranch": { "const": "main" },
        "pagesAutomaticDeploysEnabled": { "type": "boolean" },
        "pagesLive": { "const": true },
        "candidateCommitChecked": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidateCommitRecordCount": { "type": "integer", "minimum": 0 },
        "candidateCommitSkippedRecordCount": { "type": "integer", "minimum": 0 },
        "candidateCommitStartedRecordCount": { "const": 0 },
        "candidateCommitAliasedRecordCount": { "const": 0 },
        "candidateCommitActiveDeploymentCount": { "const": 0 },
        "services": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/productionServiceAnchor" },
                { "properties": { "name": { "const": "quantgym-api" }, "visibility": { "const": "public" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/productionServiceAnchor" },
                { "properties": { "name": { "const": "quantgym-llm" }, "visibility": { "const": "internal" } } }
              ]
            }
          ],
          "items": false
        },
        "postgresControlSha256": { "$ref": "#/$defs/sha256" },
        "r2ControlSha256": { "$ref": "#/$defs/sha256" },
        "environmentGroupsControlSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "previewAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pagesDeploymentCommit", "apiDeploymentCommit", "llmDeploymentCommit", "llmResourceIdentitySha256", "llmConfigurationSha256", "llmRepository", "llmBranch", "llmVisibility", "llmAutomaticDeploysEnabled", "llmLive", "databaseRevision"],
      "properties": {
        "pagesDeploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "apiDeploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "llmDeploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "llmResourceIdentitySha256": { "$ref": "#/$defs/sha256" },
        "llmConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "llmRepository": { "const": "garymmmjw/QuantGym" },
        "llmBranch": { "const": "codex/frontend-v2-preview" },
        "llmVisibility": { "const": "internal" },
        "llmAutomaticDeploysEnabled": { "const": false },
        "llmLive": { "const": true },
        "databaseRevision": { "enum": ["0001_phase1_foundation", "0002_phase2_daily_training"] }
      }
    },
    "productionContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "beforeCheckedAt", "after", "afterCheckedAt", "controlIdentitySha256", "unchanged"],
      "properties": {
        "before": { "$ref": "#/$defs/productionAnchor" },
        "beforeCheckedAt": { "$ref": "#/$defs/timestamp" },
        "after": { "$ref": "#/$defs/productionAnchor" },
        "afterCheckedAt": { "$ref": "#/$defs/timestamp" },
        "controlIdentitySha256": { "$ref": "#/$defs/sha256" },
        "unchanged": { "const": true }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "resourceIdentitySha256", "commit", "status"],
      "properties": {
        "provider": { "enum": ["cloudflare-pages", "render"] },
        "resourceIdentitySha256": { "$ref": "#/$defs/sha256" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "status": { "const": "ready" }
      }
    },
    "pagesDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "resourceIdentitySha256", "commit", "status", "artifactManifestSha256"],
      "properties": {
        "provider": { "const": "cloudflare-pages" },
        "resourceIdentitySha256": { "$ref": "#/$defs/sha256" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "status": { "const": "ready" },
        "artifactManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "deployments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "pages"],
      "properties": {
        "api": { "$ref": "#/$defs/deployment" },
        "pages": { "$ref": "#/$defs/pagesDeployment" }
      }
    },
    "deploymentControls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pagesAutomaticDeploysDisabled", "apiAutomaticDeploysDisabled", "llmAutomaticDeploysDisabled", "migrationPrecedesDeploy", "evidenceSha256"],
      "properties": {
        "pagesAutomaticDeploysDisabled": { "const": true },
        "apiAutomaticDeploysDisabled": { "const": true },
        "llmAutomaticDeploysDisabled": { "const": true },
        "migrationPrecedesDeploy": { "const": true },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "databaseContentTable": {
      "type": "object",
