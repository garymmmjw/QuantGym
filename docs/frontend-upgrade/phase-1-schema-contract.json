    {
      "name": "auth_challenges",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "primaryKey": true
        },
        {
          "name": "user_id",
          "type": "uuid",
          "nullable": true,
          "references": "users.id",
          "onDelete": "set null"
