  "pkceVerifierPolicy": {
    "storage": "short-lived-encrypted",
    "plaintextStored": false,
    "destroyOnConsume": true,
    "destroyOnExpiry": true,
    "expiredRowAction": "delete"
  },
  "auditRetentionPolicy": {
    "userDeletion": "restrict",
    "userLifecycle": "soft-disable-with-status",
    "previewDestruction": "governed-full-database-destroy"
  },
  "forbiddenTables": [
    "state_json",
    "xp_ledger",
    "coin_ledger",
    "rating_history",
    "league_entries",
    "problems",
    "interview_sessions"
  ],
  "forbiddenColumns": [
    "state_json",
    "legacy_id",
    "sqlite_rowid"
  ],
  "migrationRoundTrip": [
    "upgrade-head",
    "fingerprint",
    "downgrade-base",
    "empty",
    "upgrade-head",
    "same-fingerprint"
  ],
  "sharedPreviewDowngradeAllowed": false
