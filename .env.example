OPENAI_API_KEY=
PORT=8787
LLM_PROXY_HOST=127.0.0.1
LLM_ALLOWED_ORIGINS=http://127.0.0.1:5176
# Set in beta deployment to require a valid cloud session before LLM calls.
# LLM_AUTH_API_BASE=https://api.quantgym.app/api
# Raise this for larger PDF uploads after checking your proxy/body limits.
LLM_MAX_BODY_BYTES=12582912

# API beta deployment example.
# PORT=8790
# QUANTGYM_HOST=0.0.0.0
# QUANTGYM_DB=/var/data/quantgym.sqlite3
# QUANTGYM_ALLOWED_ORIGINS=https://beta.quantgym.app
# Require invitations for new accounts; existing users can still log in.
QUANTGYM_REQUIRE_INVITE_CODE=1
# Legacy mode only (QUANTGYM_REQUIRE_INVITE_CODE=0):
# QUANTGYM_BETA_EMAIL_ALLOWLIST=tester1@example.com,tester2@example.com

# API email verification. Without SMTP, api-server/server.py prints dev codes
# to its terminal and returns devCode for local testing.
QUANTGYM_REQUIRE_EMAIL_VERIFICATION=1
QUANTGYM_EMAIL_CODE_TTL_MINUTES=10
QUANTGYM_EMAIL_CODE_COOLDOWN_SECONDS=60
QUANTGYM_EMAIL_DEV_CODE_RESPONSE=1
# QUANTGYM_SMTP_HOST=smtp.resend.com
# QUANTGYM_SMTP_PORT=587
# QUANTGYM_SMTP_USERNAME=resend
# QUANTGYM_SMTP_PASSWORD=
# QUANTGYM_SMTP_FROM="QuantGym <no-reply@quantgym.app>"

# Guardian emails reuse the API SMTP configuration above. Without SMTP,
# reminders return an unavailable error; completed-goal notifications wait in
# the database and resume after SMTP is configured and the API is restarted.
# QUANTGYM_GUARDIAN_SESSION_HOURS=8
# QUANTGYM_GUARDIAN_POLL_SECONDS=15
# QUANTGYM_GUARDIAN_REMINDER_COOLDOWN_SECONDS=3600
# QUANTGYM_GUARDIAN_REMINDER_DAILY_MAX=3
